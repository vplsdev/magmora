/eval/lead_network_hypotheses.py
# pedal scoring against private recordings and captures
/eval/pedal_capture/
# cabinet harness: loaders, scoring, yardsticks and diagnostics against the private reference recordings
/eval/cab/*
!/eval/cab/metrics.py
!/eval/cab/test_virtualmic.py
# cabinet model: round-by-round tuners, renderers and superseded rounds (the shipped model is model8.py and its bases)
/proto/cab/_legacy.py
/proto/cab/legacy/
/proto/cab/prefit.py
/proto/cab/render*.py
/proto/cab/tune*.py
/proto/cab/model6.py
/proto/cab/model9.py
/proto/cab/model10.py
# the pitch transposer's prototype: its harness and the comparison code it vendors; the shipped transposer is
# dsp/src/transpose and needs none of it
/proto/transpose/
