# never commit captures (case-insensitive patterns, because CI and Linux checkouts are case-sensitive)
*.[nN][aA][mM]
*.[aA][iI][dD][aA][xX]
*.[tT][sS][rR]
*.[kK][iI][pP][rR]
*.[pP][tT]
*.[cC][kK][pP][tT]

# never commit audio: DI tracks, renders, impulse responses
*.[wW][aA][vV]
*.[wW]64
*.[rR][fF]64
*.[aA][iI][fF]
*.[aA][iI][fF][fF]
*.[fF][lL][aA][cC]
*.[mM][pP]3
*.[mM]4[aA]
*.[aA][aA][cC]
*.[oO][gG][gG]
*.[oO][pP][uU][sS]
*.[cC][aA][fF]
*.[iI][rR][sS]
# raw float audio: only the synthetic SPICE reference data
*.f32
*.f64
*.npy
*.npz
!reference/**/*.f32
!reference/**/*.f64

# never commit schematics, manuals, scans or reference photos: images only where our own art lives
*.[pP][dD][fF]
*.[dD][jJ][vV][uU]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[bB][mM][pP]
*.[gG][iI][fF]
*.[wW][eE][bB][pP]
*.[hH][eE][iI][cC]
*.[eE][xX][rR]
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
!plugin/resources/img/**/*.png
!plugin/resources/img/**/*.jpg
!art/textures/**/*.png
!art/textures/**/*.jpg
!docs/images/**/*.png
!docs/images/**/*.jpg
*[sS][cC][hH][eE][mM][aA][tT][iI][cC]*.[sS][vV][gG]

# ---------------------------------------------------------------------------------------------------------------
# internal (not published): working notes, planning logs and tooling that only runs against private data.
# These files stay in the working tree for the maintainers; they are not part of the public repository.
# ---------------------------------------------------------------------------------------------------------------
# planning, amendment and decision logs, porting notes, research-round notes
/docs/AMENDMENTS.md
/docs/PLAN.md
/docs/PLAN_EXPANSION.md
/docs/DECISIONS.md
/docs/MODEL_CHANGES.md
/docs/research/EXPANSION.md
